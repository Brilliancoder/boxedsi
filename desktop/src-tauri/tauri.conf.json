{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Boxed",
  "version": "0.1.0",
  "identifier": "si.boxed.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "boxed.si",
        "width": 860,
        "height": 780,
        "minWidth": 560,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE-WITH-THE-MINISIGN-PUBLIC-KEY-FROM-cargo-tauri-signer-generate",
      "endpoints": ["https://updates.example.invalid/boxed/desktop/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
